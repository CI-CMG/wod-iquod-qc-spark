executable = wod-iquod-qc-spark-container.sh
arguments = $(year) $(dataset) $(check)

+SingularityImage = "osdf:///ospool/ap21/data/electricsam/spark-3.4.3-bin-hadoop3-scala2.13-v1.sif"
+JobBatchName = "WOD-IQUOD-QC"

should_transfer_files = YES
transfer_input_files = wod-iquod-qc-spark-${project.version}.jar, wod-iquod-qc.conf
when_to_transfer_output = ON_EXIT
transfer_output_files = ""


log = wod-iquod-qc-spark/$(dataset)/$(year)/$(check)/job.log
output = wod-iquod-qc-spark/$(dataset)/$(year)/$(check)/job.out
error = wod-iquod-qc-spark/$(dataset)/$(year)/$(check)/job.err

request_cpus = 4
request_memory = 20GB
request_disk = 20GB

queue