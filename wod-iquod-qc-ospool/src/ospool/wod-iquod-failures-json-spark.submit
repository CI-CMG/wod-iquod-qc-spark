executable = wod-iquod-failures-json-spark.sh
arguments = $(year) $(dataset) $(date_folder)

+JobBatchName = "WOD-IQUOD-FAILURES-JSON"

username =
access_point =
OSDF_LOCATION = osdf:///ospool/$(access_point)/data/$(username)/$(date_folder)
JSON_LOCATION = $(OSDF_LOCATION)/data/json/$(dataset)/OBS/$(year)

should_transfer_files = YES
transfer_input_files = OpenJDK11U-jre_x64_linux_hotspot_11.0.23_9.tar.gz,spark-3.5.3-bin-hadoop3-scala2.13.tgz,wod-iquod-qc-spark-${project.version}.jar,$(OSDF_LOCATION)/resources.tar.gz$(dependsOn)
when_to_transfer_output = ON_EXIT
transfer_output_files = failures.tar.gz,summary.tar.gz
transfer_output_remaps = "failures.tar.gz=$(JSON_LOCATION)/failure.json.tar.gz;summary.tar.gz=$(JSON_LOCATION)/summary.json.tar.gz"

periodic_release = (NumJobStarts < 4) && ((CurrentTime - EnteredCurrentStatus) > 15*60)
periodic_remove = (NumJobStarts >= 4)

starter_log = wod-iquod-failures-json-spark/$(dataset)/$(year)/job.starter.log
log = wod-iquod-failures-json-spark/$(dataset)/$(year)/job.log
output = wod-iquod-failures-json-spark/$(dataset)/$(year)/job.out
error = wod-iquod-failures-json-spark/$(dataset)/$(year)/job.err

request_cpus = 4
request_memory = 20GB
request_disk = 20GB

queue