executable = wod-iquod-qc-spark.sh
arguments = $(year) $(dataset) $(check)

+JobBatchName = "WOD-IQUOD-QC"

should_transfer_files = YES
transfer_input_files = OpenJDK11U-jre_x64_linux_hotspot_11.0.23_9.tar.gz, spark-3.4.3-bin-hadoop3-scala2.13.tgz, wod-iquod-qc-spark-${project.version}.jar, wod-iquod-qc.conf
when_to_transfer_output = ON_EXIT
transfer_output_files = ""


log = wod-iquod-qc-spark/$(dataset)/$(year)/$(check)/job.log
output = wod-iquod-qc-spark/$(dataset)/$(year)/$(check)/job.out
error = wod-iquod-qc-spark/$(dataset)/$(year)/$(check)/job.err

request_cpus = 4
request_memory = 8GB
request_disk = 10GB

queue